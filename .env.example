# SAFE TO COMMIT: placeholders only.
# Copy to `.env` (gitignored); never commit real JWT_SECRET or MONGODB_URI.

# ==========================================
# Frontend (Vite)
# ==========================================
# Base URL used by React app to call backend APIs
VITE_API_BASE_URL=http://localhost:4000

# ==========================================
# Backend (Node/Express)
# ==========================================
# API server port
PORT=4000

# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:5173

# JWT signing secret (change in production)
JWT_SECRET=replace-with-a-long-random-secret

# ==========================================
# MongoDB Atlas
# ==========================================
# Full SRV connection string (keep secret; never commit real values)
# Include database name before ? e.g. ...mongodb.net/propertyfish?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/propertyfish?retryWrites=true&w=majority

# Database name (optional; defaults to propertyfish)
MONGODB_DB_NAME=propertyfish
