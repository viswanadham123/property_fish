# ==========================================
# Frontend (Vite - Production)
# ==========================================
# Public API URL used by the deployed frontend
VITE_API_BASE_URL=https://api.yourdomain.com

# ==========================================
# Backend (Node/Express - Production)
# ==========================================
# API server port (often injected by hosting platform)
PORT=4000

# Deployed frontend origin
CORS_ORIGIN=https://yourdomain.com

# MUST be a long secure random secret in production
JWT_SECRET=replace-with-very-long-secure-random-secret

NODE_ENV=production
