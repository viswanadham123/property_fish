# =============================================================================
# Render: split frontend + backend (two Web Services)
# =============================================================================
#
# --- Service A: FRONTEND (builds Vite; no Node secrets here) ---
#   VITE_API_BASE_URL=https://property-fish-backend.onrender.com
#
# --- Service B: BACKEND (Node: server.js) ---
#   MONGODB_URI=mongodb+srv://USER:PASSWORD@host/propertyfish?retryWrites=true&w=majority
#   MONGODB_DB_NAME=propertyfish
#   JWT_SECRET=random-string-at-least-32-characters (or SESSION_SECRET — same min length; required when NODE_ENV=production)
#   CORS_ORIGIN=https://property-fish.onrender.com http://localhost:5173 http://localhost:5174
#     (space and/or comma between origins — both work)
#
# Do NOT set MONGODB_URI or JWT_SECRET on the frontend service.
# Do NOT set VITE_* on the backend unless you have a reason (not required for API).
#
# =============================================================================
# Single Render service (one URL serves /api + static app): leave VITE empty.
# =============================================================================

# Render does NOT load this file for secrets — set variables in the Render Dashboard
# (Web Service → Environment). NODE_ENV is often "production" on Render, which triggers
# a required JWT secret (see backend/server.js).

VITE_API_BASE_URL=https://property-fish-backend.onrender.com

PORT=4000
# Optional on Render (often set automatically). Triggers strict JWT + sanitized API errors.
# NODE_ENV=production
CORS_ORIGIN=https://property-fish.onrender.com,http://localhost:5173,http://localhost:5174
# Required when NODE_ENV=production (min 32 chars). You may use SESSION_SECRET instead of JWT_SECRET on Render.
JWT_SECRET=replace-with-very-long-secure-random-secret-at-least-32-chars
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/propertyfish?retryWrites=true&w=majority
MONGODB_DB_NAME=propertyfish
