# ==========================================
# Frontend (Vite - Production, Render same service)
# ==========================================
# Leave empty so the browser calls /api/* on the same origin as the UI.
# Only set this if the API is hosted on a different domain than the frontend.
VITE_API_BASE_URL=

# ==========================================
# Backend (Node/Express - Production)
# ==========================================
PORT=4000

# Your live site (CORS). Example: https://property-fish.onrender.com
CORS_ORIGIN=https://property-fish.onrender.com

JWT_SECRET=replace-with-very-long-secure-random-secret

# MongoDB Atlas — use the full SRV string from Atlas; add DB name in the path.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/propertyfish?retryWrites=true&w=majority
MONGODB_DB_NAME=propertyfish
